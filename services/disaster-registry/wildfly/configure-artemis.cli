embed-server --server-config=standalone-full.xml --std-out=echo
/socket-binding-group=standard-sockets/remote-destination-outbound-socket-binding=remote-artemis:add(host="${env.BROKER_HOST:artemis}",port="${env.BROKER_PORT:61616}")
/subsystem=messaging-activemq/remote-connector=remote-artemis-connector:add(socket-binding=remote-artemis)
/subsystem=messaging-activemq/pooled-connection-factory=artemis-remote-cf:add(connectors=[remote-artemis-connector],entries=["java:/jms/RemoteCF"],user="${env.BROKER_USER:disaster}",password="${env.BROKER_PASSWORD:disaster}",enable-amq1-prefix=false)
stop-embedded-server