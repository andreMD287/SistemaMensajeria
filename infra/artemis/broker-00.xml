<?xml version="1.0" encoding="UTF-8"?>
<!-- Topología del taller: se fusiona con broker.xml al iniciar el contenedor (etc-override). -->
<configuration xmlns="urn:activemq" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xmlns:xi="http://www.w3.org/2001/XInclude"
               xsi:schemaLocation="urn:activemq /schema/artemis-configuration.xsd">
  <core xmlns="urn:activemq:core">

    <addresses>
      <!-- Reportes entrantes: cola punto a punto -->
      <address name="disaster.registration.in">
        <anycast><queue name="disaster.registration.in"/></anycast>
      </address>

      <!-- Eventos: tópico (multicast). Cada suscriptor tiene su propia cola; otros sistemas agregan la suya aquí. -->
      <address name="disaster.events">
        <multicast><queue name="notifications.disaster-registered"/></multicast>
      </address>

      <!-- Mensajes que agotaron los reintentos -->
      <address name="disaster.registration.dlq">
        <anycast><queue name="disaster.registration.dlq"/></anycast>
      </address>
      <address name="notifications.dlq">
        <anycast><queue name="notifications.dlq"/></anycast>
      </address>
    </addresses>

    <address-settings>
      <address-setting match="disaster.registration.in">
        <dead-letter-address>disaster.registration.dlq</dead-letter-address>
        <max-delivery-attempts>5</max-delivery-attempts>
        <redelivery-delay>2000</redelivery-delay>
        <auto-create-queues>false</auto-create-queues>
        <auto-create-addresses>false</auto-create-addresses>
      </address-setting>
      <address-setting match="disaster.events">
        <dead-letter-address>notifications.dlq</dead-letter-address>
        <max-delivery-attempts>5</max-delivery-attempts>
        <redelivery-delay>2000</redelivery-delay>
        <auto-create-queues>false</auto-create-queues>
        <auto-create-addresses>false</auto-create-addresses>
      </address-setting>
    </address-settings>

  </core>
</configuration>
